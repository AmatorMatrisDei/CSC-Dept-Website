{
  "name": "csc-dept-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "db:start": "supabase start -x realtime,edge-runtime,logflare,vector,imgproxy,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase db lint --local -s public,private --fail-on error && supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/database.types.ts",
    "test:api": "node --test supabase/tests/api/api.test.mjs supabase/tests/api/cms-concurrency.test.mjs",
    "test:api:cms": "node --test supabase/tests/api/cms-concurrency.test.mjs",
    "functions:serve": "supabase functions serve --env-file supabase/functions/.env",
    "test:carousel": "node --experimental-strip-types --test supabase/functions/_shared/carousel-pick.test.ts",
    "test:e2e": "node --test tests/e2e/student-submissions.test.mjs tests/e2e/cms-editing.test.mjs",
    "test:e2e:cms": "node --test tests/e2e/cms-editing.test.mjs",
    "test:unit": "node --experimental-strip-types --test \"src/**/*.test.ts\" \"supabase/functions/_shared/review-message.test.ts\" \"supabase/functions/_shared/account-email.test.ts\" \"supabase/functions/_shared/turnstile.test.ts\"",
    "preview": "vite preview",
    "icons": "node scripts/icons.mjs",
    "changes": "node scripts/changes.mjs"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@supabase/supabase-js": "^2.117.3",
    "animejs": "^4.5.0",
    "exceljs": "^4.4.0",
    "markdown-to-jsx": "^9.10.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "playwright-core": "^1.63.0",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module"
}
