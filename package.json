{
  "name": "csc-dept-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:start": "supabase start -x realtime,edge-runtime,logflare,vector,imgproxy,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase db lint --local -s public,private --fail-on error && supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/database.types.ts",
    "test:api": "node --test supabase/tests/api/api.test.mjs",
    "functions:serve": "supabase functions serve --env-file supabase/functions/.env",
    "test:carousel": "node --experimental-strip-types --test supabase/functions/_shared/carousel-pick.test.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.11",
    "next": "^16.3.8",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.150.0"
  },
  "engines": {
    "node": ">=22"
  }
}
