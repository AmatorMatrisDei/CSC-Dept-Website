# Copy to .env for `supabase functions serve`. On hosted projects, set it with
# `npx supabase secrets set CAROUSEL_CRON_SECRET=...` and store the same value in Vault (docs/backend-setup.md).
CAROUSEL_CRON_SECRET=local-carousel-secret
# Sites allowed to call the function from a browser (comma-separated; https://*.example.com allows subdomains).
CAROUSEL_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# notify-reviewers: the database calls it with this secret (also stored in Vault as notify_secret).
NOTIFY_SECRET=local-notify-secret
# Where review links point.
SITE_URL=http://localhost:5173
# Where messages go: a GroupMe bot ID and/or a Discord webhook. Leave both empty to send nothing.
GROUPME_BOT_ID=
DISCORD_WEBHOOK_URL=
# verify-email and password-reset (see _shared/account-email-setup.ts). With no FIREBASE_API_KEY
# they answer "unavailable"; FIREBASE_API_URL can point them at a stand-in for Firebase.
FIREBASE_API_KEY=
FIREBASE_LINK_SECRET=local-link-secret
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FIREBASE_API_URL=
