# Supabase project URL and publishable key. Both are safe to expose to the browser.
# Local: http://127.0.0.1:54321 and the "Publishable" key from `npx supabase status`.
# Hosted: Supabase dashboard > Project Settings > API Keys. Never put the secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile site key (public), for the "are you a person?" check on sign-in, sign-up and
# password reset. Leave empty locally: no check. Cloudflare's test key 1x00000000000000000000AA
# always passes, for trying it out.
VITE_TURNSTILE_SITE_KEY=
