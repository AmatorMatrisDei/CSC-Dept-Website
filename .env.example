# Base URL of the Drupal site (JSON:API module enabled). Leave empty to use sample content.
DRUPAL_BASE_URL=
# Shared secret Drupal sends to /api/revalidate when content changes.
DRUPAL_REVALIDATE_SECRET=

# Supabase project URL and publishable key. Both are safe to expose to the browser.
# Local: http://127.0.0.1:54321 and the "Publishable" key from `npx supabase status`.
# Hosted: Supabase dashboard > Project Settings > API Keys. Never put the secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
